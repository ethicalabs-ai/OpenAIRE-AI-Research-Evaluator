# =============================================================================
# Echo-DSRN Graph — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit secrets.
#
# Generate SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# -----------------------------------------------------------------------------
# Hugging Face
# -----------------------------------------------------------------------------
# Token for gated/private model access (e.g. Echo-DSRN classifier).
# Used during Docker build; not needed at runtime if model is baked into image.
# HF_TOKEN=hf_...

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=7860

# Base URL reachable from the internet (used to build OAuth redirect URIs)
# Example: https://your-app.hf.space  or  http://localhost:7860
APP_BASE_URL=http://localhost:7860

# -----------------------------------------------------------------------------
# Security — JWT Session Signing
# -----------------------------------------------------------------------------
# REQUIRED in production.  Must be at least 32 random bytes.
SECRET_KEY=

# JWT algorithm (default HS256 — change to RS256 for asymmetric keys)
JWT_ALGORITHM=HS256

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLite (default — fine for development and small deployments)
# Leave blank to use the default path: data/collaborative.db
DATABASE_URL=

# PostgreSQL example (recommended for production):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/echo_dsrn

# -----------------------------------------------------------------------------
# OAuth — Hugging Face
# -----------------------------------------------------------------------------
# Create an OAuth app at: https://huggingface.co/settings/applications/new
# Redirect URI: ${APP_BASE_URL}/api/auth/callback/hf
HF_CLIENT_ID=
HF_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Model / Inference (optional overrides)
# -----------------------------------------------------------------------------
# Path to the fine-tuned Echo-DSRN intent classifier checkpoint.
# Defaults to ethicalabs/Echo-DSRN-v0.1.3-Research-Intent-CLF if unset.
# INTENT_CLF_PATH=

# -----------------------------------------------------------------------------
# Development flags
# -----------------------------------------------------------------------------
# Set to "true" to enable verbose SQL query logging
# SQL_ECHO=false

# -----------------------------------------------------------------------------
# LLM-as-Judge
# -----------------------------------------------------------------------------
# Base URL of your local OpenAI-compatible inference server.
# Defaults to http://192.168.1.40:13305/v1
LLM_BASE_URL=http://192.168.1.40:13305/v1

# API key — use "not-needed" for local servers that skip auth
LLM_API_KEY=not-needed
